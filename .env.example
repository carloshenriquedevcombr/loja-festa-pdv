# Copie para .env e proteja:   cp .env.example .env && chmod 600 .env
# Gere cada segredo com:       openssl rand -hex 32
# (hex evita caracteres que quebram a URL do banco)
# O .env NUNCA vai para o git (.gitignore) e NUNCA é colado no Portainer.

# --- Banco ---
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=

# --- App ---
SESSION_SECRET=
# Chave que cifra CPF, telefone, e-mail, endereço, medidas e contratos (openssl rand -hex 32).
# GUARDE UMA CÓPIA FORA DA VPS (gerenciador de senhas / papel no cofre): sem ela os dados cifrados
# e os backups ficam ilegíveis para sempre. Nunca troque depois de começar a usar.
DADOS_CHAVE=
# 1 quando o domínio estiver com a nuvem laranja da Cloudflare ligada (docs/VPS.md, "Cloudflare")
CLOUDFLARE=0
# Com CLOUDFLARE=1: 1 = a área da equipe só abre do Brasil (o site da vitrine continua aberto)
SO_BRASIL=1
# Minutos parado até o sistema pedir a senha de novo
SESSAO_OCIOSA_MIN=30
# Preenchido depois do comando "criar-loja" (veja docs/VPS.md, passo 6)
LOJA_ID=
# Endereço público do site, com https (o Mercado Pago avisa os pagamentos aqui)
SITE_URL=

# --- Rede do Nginx Proxy Manager (descubra com: docker network ls) ---
NPM_NETWORK=

# --- Backup ---
BACKUP_HORA=03:00
# Cópia externa criptografada (recomendado). Exemplo com Backblaze B2 via S3:
#   RESTIC_REPOSITORY=s3:s3.us-west-004.backblazeb2.com/nome-do-bucket/loja
RESTIC_REPOSITORY=
# Guarde esta senha também FORA da VPS: sem ela o backup externo não abre.
RESTIC_PASSWORD=
RESTIC_S3_ACCESS_KEY=
RESTIC_S3_SECRET_KEY=
# Outros domínios da loja além do SITE_URL (separados por vírgula), ex.: loja.com.br,www.loja.com.br
HOSTS_PERMITIDOS=

# --- Site: nota do Google, frete (opcional) ---
# Chave da API Google Places (Google Cloud > APIs > Places API (New)); restrinja a chave ao IP da VPS.
# Sem ela, a nota do Google é digitada pela Dona em Site > Avaliações.
GOOGLE_PLACES_KEY=
# Token do Melhor Envio (melhorenvio.com.br > Configurações > Tokens), para cotar frete e gerar etiquetas.
MELHOR_ENVIO_TOKEN=
# 1 = ambiente de teste do Melhor Envio (sandbox.melhorenvio.com.br)
MELHOR_ENVIO_SANDBOX=0
